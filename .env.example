DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startek_restaurant_pos?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
TRUSTED_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Startek Restaurant POS"
NEXT_PUBLIC_APP_VERSION="1.0.0"
# Required only when seeding a brand-new database with no admin account.
# SEED_SUPER_ADMIN_PASSWORD="replace-with-a-unique-strong-installation-password"
BACKUP_DIR="./.backups"
# Bind to 127.0.0.1 for workstation-only access. Use 0.0.0.0 only for a trusted restaurant LAN.
POS_HOST="127.0.0.1"
POS_PORT="3000"
# Optional absolute executable overrides when PostgreSQL tools are not on PATH.
# PG_DUMP_PATH="/path/to/pg_dump"
# PG_RESTORE_PATH="/path/to/pg_restore"
